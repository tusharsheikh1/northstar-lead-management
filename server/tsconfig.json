{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "types": ["node"]
  },
  "include": ["src", "test", "../src/types.ts"]
}
