# Copy to .env and adjust
PORT=3000
DATABASE_URL=postgres://northstar:northstar@localhost:5432/northstar
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-in-production
# Set when the frontend is served from a different origin than the API (not needed with the Vite proxy)
# Sign-in / register attempts allowed per IP every 15 minutes
AUTH_RATE_LIMIT=30
CORS_ORIGIN=
NODE_ENV=development
