# Copy to .env and adjust
PORT=3000
DATABASE_URL=postgres://northstar:northstar@localhost:5432/northstar
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-in-production
# Set when the frontend is served from a different origin than the API (not needed with the Vite proxy)
# Sign-in / register attempts allowed per IP every 15 minutes
AUTH_RATE_LIMIT=30
CORS_ORIGIN=
NODE_ENV=development

# ---- Email (SMTP). Leave SMTP_HOST empty to keep email disabled. ----
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Northstar CRM <no-reply@yourdomain.com>
# Development only: write emails to the server log instead of sending (they are NOT delivered)
# EMAIL_TRANSPORT=log

# ---- SMS (Bangladesh). Leave SMS_PROVIDER empty to keep SMS disabled. ----
# bulksmsbd | alphasms | sslwireless | log (log = development only, NOT delivered)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
# SSL Wireless only: your SID (brand/masking name)
SSLWIRELESS_SID=

# Set to true to turn off the reminder / weekly-summary / outbox worker (e.g. on extra instances)
# DISABLE_SCHEDULER=false
